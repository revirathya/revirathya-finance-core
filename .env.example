# --- Required ---
VERSION=
MIGRATION_VERSION=
DB_PASSWORD=
# For `make run` / `make migrate-*` (host machine). Docker mode builds its own.
DATABASE_URI=postgres://revirathya:<password>@localhost:5532/finance?sslmode=disable
# Shared secret the Telegram bot sends as "authorization: Bearer <key>". Generate: openssl rand -base64 32
GRPC_API_KEY=
# For OIDC
GOOGLE_CLIENT_ID=
# JWT secret (must be > 32 bytes)
JWT_SECRET=

# --- Optional: defaults shown ---
# DB_USER=revirathya
# DB_NAME=finance
# GRPC_PORT=50051
# GRPC_ENABLE_REFLECTION=false
# GQL_PORT=8080
# GQL_ENABLE_INTROSPECTION=false
# ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
# JWT_TTL=24h

# --- Optional: host ports for Docker mode (`make up`) ---
# DB_HOST_PORT=5532
# GQL_HOST_PORT=8180
# GRPC_HOST_PORT=51051
