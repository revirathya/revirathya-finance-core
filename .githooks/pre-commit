#!/bin/sh
set -e

staged=$(git diff --cached --name-only --diff-filter=ACM)

# 1. Formatting and vet, only when Go files are staged
go_files=$(echo "$staged" | grep '\.go$' || true)
if [ -n "$go_files" ]; then
  unformatted=$(gofmt -l $go_files)
  if [ -n "$unformatted" ]; then
    echo "gofmt needed:"; echo "$unformatted"; echo "Run: gofmt -w <files>"; exit 1
  fi
  go vet ./...
fi

# 2. Codegen drift, only when a source-of-truth file is staged (same check as CI's codegen job)
if echo "$staged" | grep -qE '^(proto/|graphql/schema/|sqlc/queries/|migrations/|sqlc\.yaml|gqlgen\.yml|buf\.(gen\.)?yaml)'; then
  if [ "${SKIP_CODEGEN:-}" = "1" ]; then
    echo "pre-commit: skipping codegen check (SKIP_CODEGEN=1)"
  else
    make generate >/dev/null
    if ! git diff --quiet -- gen/ internal/delivery/http/graphql/resolver/; then
      echo "Generated code is out of date. Stage it:"; git diff --stat -- gen/ internal/delivery/http/graphql/resolver/
      exit 1
    fi
  fi
fi
