# ------ Application ------
# Defined as application versioning or deployment environment

# [Defaulted] Running environment of application
# default: prod
APP_ENV=dev

# [Required] Database URI for core connections.
# Also used by `make run` / `make migrate-*` (host machine). Docker mode builds its own.
# Adjust all value on `<value>` to valid values
DATABASE_URI=postgres://<db_username>:<db_password>@<hostname>:<port>/<db_name>?sslmode=disable

# [Required] gRPC static API Key.
# Shared secret for other services, used in "authorization: Bearer <key>".
# Generate: openssl rand -base64 32
GRPC_API_KEY=

# [Defaulted] gRPC Port
# Exposed port for gRPC service. Hardcoded in `docker-compose.yaml`
# GRPC_PORT=50051

# [Defaulted] HTTP Port
# Exposed port for HTTP service (GraphQL endpoint). Hardcoded in `docker-compose.yaml`
# HTTP_PORT=8080

# [Defaulted] Metrics Port
# Exposed port for Metrics collector service. Hardcoded in `docker-compose.yaml`
# METRICS_PORT=9090

# [Defaulted] gRPC Enable Reflection
# default: true (in dev). false (in prod)
# Enabling reflection for gRPC service
# GRPC_ENABLE_REFLECTION=false

# [Defaulted] GraphQL Enable Introspection
# default: true (in dev). false (in prod)
# Enabling introspection for GraphQL service
# GQL_ENABLE_INTROSPECTION=false

# [Defaulted] Allowed Origins
# default: "http://localhost,http://127.0.0.1"
# List of allowed origins for cross-server access (used by CORS on HTTP service) separated by ','
# ALLOWED_ORIGINS="http://localhost,http://127.0.0.1"

# [Required] Google Client ID
# Registered Google Client ID used for OAUTH login (client ID to set authorized URL/redirect)
GOOGLE_CLIENT_ID=

# [Required] JWT Secret
# JWT secret key (must be at least 32 bytes)
# Generate: openssl rand -base64 32
JWT_SECRET=

# [Defaulted] JWT TTL
# default: 24h
# JWT TTL durations
# JWT_TTL=24h

# [Defaulted] Log Format
# default: json
# Type of log presentation (choices: json / text)
# LOG_FORMAT=json

# [Defaulted] Log Level
# default: info
# Set level of system logs
LOG_LEVEL=info


# ------ Docker & Makefile ------
# Used by Docker image build and deployment with `docker-compose.yaml`

# [Required] Application (Core) tags
# Used by `make docker-build` / `make docker-up` (used by infra/docker-compose.yaml)
VERSION=

# [Required] Database Migration tags
# Used by `make docker-build svc=migration` / `make docker-up` (used by infra/docker-compose.yaml)
MIGRATION_VERSION=

# [Defaulted] Database User
# default: revirathya
# Username for Postgres database connection.
# Used by `core` connections and `db` definition in 'infra/docker-compose.yaml'
# DB_USER=revirathya

# [Required] Database Password
# Password for Postgres database connection
# Used by `core` connections and `db` definition in 'infra/docker-compose.yaml'
DB_PASSWORD=

# [Defaulted] Database Name
# default: finance
# Database used by application (core) service and target of migration
# Used by `core` connections and `db` definition in 'infra/docker-compose.yaml'
# DB_NAME=finance

# [Defaulted] DB Host Port
# default: 5532
# Exposed database ports from docker containers (used by 'infra/docker-compose.yaml')
# DB_HOST_PORT=5532

# [Defaulted] HTTP (GraphQL) Host Port
# default: 8180
# Exposed HTTP GraphQL ports from docker containers (used by 'infra/docker-compose.yaml')
# HTTP_HOST_PORT=8180

# [Defaulted] gRPC Host Port
# default: 51051
# Exposed gRPC ports from docker containers (used by 'infra/docker-compose.yaml')
# GRPC_HOST_PORT=51051

# [Defaulted] Metrics Host Port
# default: 9900
# Exposed metrics ports from docker containers (used by 'infra/docker-compose.yaml')
# METRICS_HOST_PORT=9900

# Tracing for local mode (make run): empty = off, http://localhost:4317 = the compose Jaeger.
# Docker mode ignores it: `make docker-up tracing=1` starts Jaeger and points core at it.
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1

# Write limit per user, shared by gRPC and GraphQL (default 15 per 1m)
# WRITE_RATE_LIMIT=15
# WRITE_RATE_WINDOW=1m
